# Copie este archivo como .env y escriba allí sus valores.
# El archivo .env nunca se sube al repositorio.

# Clave para firmar las sesiones. Genérela con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# Base de datos. En desarrollo se usa SQLite; al publicar, PostgreSQL.
DATABASE_URL=sqlite:///./plataforma.db
